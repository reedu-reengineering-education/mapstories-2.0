# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Mapbox
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mapstories
POSTGRES_USER=postgres
POSTGRES_PASSWORD=securepass

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=mail.gandi.net
SMTP_FROM=no-reply@example.de
SMTP_USER=no-reply@example.de
SMTP_PASS=securepass

# Comma seperated list of mapstories to add to gallery
GALLERY_STORIES='cliu2h3qt0003dvtwy09fn876'
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# BFDW site (second white-labeled deployment served from its own subdomain)
# -----------------------------------------------------------------------------
# Subdomain that serves the BFDW site, e.g. bfdw.mapstories.de
BFDW_DOMAIN=
# Same value, exposed to the browser to swap the logo client-side
NEXT_PUBLIC_BFDW_DOMAIN=
# Fallback gallery stories for BFDW if none are set in the database yet
GALLERY_STORIES_BFDW=

# Cookie domain shared between mapstories.de and bfdw.mapstories.de so users
# stay logged in on both, e.g. .mapstories.de. Leave empty for host-only cookies.
AUTH_COOKIE_DOMAIN=
